import java.util.ArrayList;
import java.util.List;

/**
 * Model class representing a single student's record.
 */
class Student {
    private String name;
    private String studentId;
    private int mark;

    /**
     * Constructs a Student with the given name, ID, and mark.
     *
     * @param name      the student's name (must be non-null, non-blank)
     * @param studentId the student's ID (must be non-null, non-blank)
     * @param mark      the student's mark (must be between 0 and 100 inclusive)
     * @throws IllegalArgumentException if name/studentId are invalid or mark is out of range
     */
    public Student(String name, String studentId, int mark) {
        if (name == null || name.trim().isEmpty()) {
            throw new IllegalArgumentException("Name must not be null or blank.");
        }
        if (studentId == null || studentId.trim().isEmpty()) {
            throw new IllegalArgumentException("Student ID must not be null or blank.");
        }
        if (mark < 0 || mark > 100) {
            throw new IllegalArgumentException("Mark must be between 0 and 100.");
        }

        this.name = name;
        this.studentId = studentId;
        this.mark = mark;
    }

    public String getName() {
        return name;
    }

    public String getStudentId() {
        return studentId;
    }

    public int getMark() {
        return mark;
    }

    /**
     * Attempts to update the mark. If the new mark is invalid (outside 0-100),
     * the old mark is preserved and the update fails.
     *
     * @param newMark the proposed new mark
     * @return true if the update succeeded, false if the old mark was preserved
     */
    public boolean setMark(int newMark) {
        if (newMark < 0 || newMark > 100) {
            return false;
        }
        this.mark = newMark;
        return true;
    }

    /**
     * A student passes if their mark is 50 or above.
     */
    public boolean hasPassed() {
        return mark >= 50;
    }

    /**
     * Classifies the student's performance based on their mark:
     * 80-100 -> Distinction, 70-79 -> Merit, 50-69 -> Pass, 0-49 -> Fail.
     */
    public String getClassification() {
        if (mark >= 80) {
            return "Distinction";
        } else if (mark >= 70) {
            return "Merit";
        } else if (mark >= 50) {
            return "Pass";
        } else {
            return "Fail";
        }
    }

    @Override
    public String toString() {
        return "Student{" +
                "name='" + name + '\'' +
                ", studentId='" + studentId + '\'' +
                ", mark=" + mark +
                ", passed=" + hasPassed() +
                ", classification='" + getClassification() + '\'' +
                '}';
    }
}

/**
 * Driver class that creates students, exercises setMark with valid and
 * invalid values, and prints the resulting records.
 */
public class StudentRecord {
    public static void main(String[] args) {
        List<Student> students = new ArrayList<>();

        students.add(new Student("Alice Johnson", "S1001", 49));
        students.add(new Student("Bob Smith", "S1002", 50));
        students.add(new Student("Carla Diaz", "S1003", 79));

        // Fourth student to also exercise the 80 mark case.
        Student dave = new Student("Dave Chen", "S1004", 80);
        students.add(dave);

        System.out.println("--- Initial student records ---");
        for (Student s : students) {
            System.out.println(s);
        }

        System.out.println("\n--- Testing setMark updates ---");

        // Valid update
        boolean updated1 = students.get(0).setMark(65);
        System.out.println("Alice mark update to 65 succeeded: " + updated1);

        // Another valid update
        boolean updated2 = students.get(1).setMark(90);
        System.out.println("Bob mark update to 90 succeeded: " + updated2);

        // Invalid update: out of range (negative)
        boolean invalidUpdate1 = students.get(2).setMark(-10);
        System.out.println("Carla mark update to -10 succeeded: " + invalidUpdate1
                + " (old mark preserved)");

        // Invalid update: out of range (above 100)
        boolean invalidUpdate2 = dave.setMark(150);
        System.out.println("Dave mark update to 150 succeeded: " + invalidUpdate2
                + " (old mark preserved)");

        System.out.println("\n--- Final student records ---");
        for (Student s : students) {
            System.out.println(s);
        }
    }
}
